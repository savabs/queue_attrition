# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# launchd does NOT inherit your shell environment, so exporting these in
# ~/.zshrc makes them work when you run things by hand and silently fail every
# night in the automated job. Everything here is loaded from this file instead,
# by both the wrapper and the Python entrypoints, so manual and automated runs
# behave identically.

# PJM Data Miner 2. Free, both members and non-members.
#   1. https://apiportal.pjm.com/  -> Sign in -> create a PJM account
#   2. Verify the email PJM sends
#   3. Profile -> subscriptions -> reveal the Primary key
# PJM is the largest datacenter market that publishes a queue at all, so this
# is the one credential genuinely worth having.
PJM_API_KEY=

# EIA open data (api.eia.gov). Free, instant, no approval step.
#   https://www.eia.gov/opendata/register.php
# Needed for EIA-860 plant matching -- the join that would give an independent
# "was it actually built" verdict instead of trusting each ISO's bookkeeping.
EIA_API_KEY=
